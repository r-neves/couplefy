generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?    @db.Uuid
  group_id   String?    @db.Uuid
  name       String     @db.VarChar(100)
  color      String?    @default("#6366f1") @db.VarChar(7)
  icon       String?    @db.VarChar(50)
  created_at DateTime   @default(now()) @db.Timestamp(6)
  updated_at DateTime   @default(now()) @db.Timestamp(6)
  groups     groups?    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_group_id_groups_id_fk")
  users      users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_user_id_users_id_fk")
  expenses   expenses[]
}

model expenses {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  group_id    String?    @db.Uuid
  category_id String     @db.Uuid
  amount      Decimal    @db.Decimal(10, 2)
  description String?
  date        DateTime   @db.Timestamp(6)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @db.Timestamp(6)
  categories  categories @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "expenses_category_id_categories_id_fk")
  groups      groups?    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "expenses_group_id_groups_id_fk")
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "expenses_user_id_users_id_fk")
}

model goals {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?   @db.Uuid
  group_id      String?   @db.Uuid
  name          String    @db.VarChar(100)
  target_amount Decimal?  @db.Decimal(10, 2)
  color         String?   @default("#10b981") @db.VarChar(7)
  icon          String?   @db.VarChar(50)
  description   String?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  groups        groups?   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "goals_group_id_groups_id_fk")
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "goals_user_id_users_id_fk")
  savings       savings[]
}

model group_members {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id  String   @db.Uuid
  user_id   String   @db.Uuid
  joined_at DateTime @default(now()) @db.Timestamp(6)
  groups    groups   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "group_members_group_id_groups_id_fk")
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "group_members_user_id_users_id_fk")
}

model groups {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(255)
  created_by          String                @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  categories          categories[]
  expenses            expenses[]
  goals               goals[]
  group_members       group_members[]
  users               users                 @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "groups_created_by_users_id_fk")
  invites             invites[]
  savings             savings[]
  shopping_categories shopping_categories[]
  shopping_list_items shopping_list_items[]
  saved_items         saved_items[]
  recipe_categories   recipe_categories[]
  recipes             recipes[]
  meal_plan_items     meal_plan_items[]
}

model invites {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String        @db.Uuid
  invited_by  String        @db.Uuid
  invite_code String        @unique(map: "invites_invite_code_unique") @db.VarChar(255)
  expires_at  DateTime      @db.Timestamp(6)
  created_at  DateTime      @default(now()) @db.Timestamp(6)
  status      invite_status @default(pending)
  groups      groups        @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invites_group_id_groups_id_fk")
  users       users         @relation(fields: [invited_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invites_invited_by_users_id_fk")
}

model savings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  group_id    String?  @db.Uuid
  goal_id     String   @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  date        DateTime @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  goals       goals    @relation(fields: [goal_id], references: [id], onUpdate: NoAction, map: "savings_goal_id_goals_id_fk")
  groups      groups?  @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "savings_group_id_groups_id_fk")
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "savings_user_id_users_id_fk")
}

model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String                @unique(map: "users_email_unique") @db.VarChar(255)
  name                String                @db.VarChar(255)
  avatar_url          String?
  supabase_id         String                @unique(map: "users_supabase_id_unique") @db.VarChar(255)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  role                user_role             @default(USER)
  status              access_status         @default(PENDING)
  categories          categories[]
  expenses            expenses[]
  goals               goals[]
  group_members       group_members[]
  groups              groups[]
  invites             invites[]
  savings             savings[]
  shopping_categories shopping_categories[]
  shopping_list_items shopping_list_items[]
  saved_items         saved_items[]
  recipe_categories   recipe_categories[]
  recipes             recipes[]
  meal_plan_items     meal_plan_items[]
}

enum invite_status {
  pending
  accepted
  rejected
  expired
}

enum user_role {
  USER
  ADMIN
}

enum access_status {
  PENDING
  APPROVED
  REJECTED
}

model shopping_categories {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?               @db.Uuid
  group_id            String?               @db.Uuid
  name                String                @db.VarChar(100)
  color               String?               @default("#6366f1") @db.VarChar(7)
  icon                String?               @db.VarChar(50)
  display_order       Int                   @default(0)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  groups              groups?               @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users?                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saved_items         saved_items[]
  shopping_list_items shopping_list_items[]
}

model shopping_list_items {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?                 @db.Uuid
  group_id              String?                 @db.Uuid
  category_id           String                  @db.Uuid
  name                  String                  @db.VarChar(255)
  quantity              Decimal                 @default(1) @db.Decimal(10, 2)
  unit                  String?                 @db.VarChar(50)
  completed             Boolean                 @default(false)
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @default(now()) @db.Timestamp(6)
  shopping_categories   shopping_categories     @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groups                groups?                 @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shopping_item_sources shopping_item_sources[]
}

model saved_items {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?              @db.Uuid
  group_id            String?              @db.Uuid
  category_id         String               @db.Uuid
  names               Json
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  updated_at          DateTime             @default(now()) @db.Timestamp(6)
  shopping_categories shopping_categories  @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groups              groups?              @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users?               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe_ingredients  recipe_ingredients[]
}

// --- Meal planning ---

model recipe_categories {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?   @db.Uuid
  group_id      String?   @db.Uuid
  name          String    @db.VarChar(100)
  color         String?   @default("#6366f1") @db.VarChar(7)
  icon          String?   @db.VarChar(50)
  display_order Int       @default(0)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  groups        groups?   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes       recipes[]

  @@index([user_id, group_id])
}

model recipes {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?                 @db.Uuid
  group_id              String?                 @db.Uuid
  category_id           String                  @db.Uuid
  name                  String                  @db.VarChar(255)
  notes                 String?
  servings              Int?
  last_cooked_at        DateTime?               @db.Timestamp(6)
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @default(now()) @db.Timestamp(6)
  recipe_categories     recipe_categories       @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  groups                groups?                 @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe_links          recipe_links[]
  recipe_ingredients    recipe_ingredients[]
  meal_plan_items       meal_plan_items[]
  shopping_item_sources shopping_item_sources[]

  @@index([user_id, group_id])
  @@index([category_id])
}

model recipe_links {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipe_id     String             @db.Uuid
  url           String
  label         String?            @db.VarChar(100)
  source_type   recipe_source_type @default(web)
  display_order Int                @default(0)
  created_at    DateTime           @default(now()) @db.Timestamp(6)
  recipes       recipes            @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipe_id])
}

// An ingredient resolves to a saved_items catalog entry, which supplies the
// canonical name and shopping category when it is pushed to a shopping list.
// saved_item_id stays nullable so a recipe is never blocked on cataloguing.
model recipe_ingredients {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipe_id     String       @db.Uuid
  saved_item_id String?      @db.Uuid
  raw_name      String       @db.VarChar(255)
  quantity      Decimal?     @db.Decimal(10, 2)
  unit          String?      @db.VarChar(50)
  display_order Int          @default(0)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)
  recipes       recipes      @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saved_items   saved_items? @relation(fields: [saved_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([recipe_id])
  @@index([saved_item_id])
}

// The rolling selection: one row per recipe currently in a scope's plan.
// planned_date/slot are unused today and exist so a week view can be added
// without a migration.
model meal_plan_items {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?    @db.Uuid
  group_id     String?    @db.Uuid
  recipe_id    String     @db.Uuid
  planned_date DateTime?  @db.Date
  slot         meal_slot?
  added_at     DateTime   @default(now()) @db.Timestamp(6)
  groups       groups?    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes      recipes    @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, group_id])
  @@index([recipe_id])
}

// Provenance for shopping items generated from a recipe, so removing a recipe
// from the plan can offer to take its still-unbought items back off the list.
model shopping_item_sources {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopping_list_item_id String              @db.Uuid
  recipe_id             String              @db.Uuid
  quantity              Decimal?            @db.Decimal(10, 2)
  unit                  String?             @db.VarChar(50)
  created_at            DateTime            @default(now()) @db.Timestamp(6)
  shopping_list_items   shopping_list_items @relation(fields: [shopping_list_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes               recipes             @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shopping_list_item_id, recipe_id])
  @@index([recipe_id])
}

enum recipe_source_type {
  web
  cookidoo
  book
  other
}

enum meal_slot {
  lunch
  dinner
  other
}
